# Copy this file to .env and fill in real values.
PORT=5000

# MongoDB Atlas connection string (free tier works fine)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sparkx?retryWrites=true&w=majority

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://sparkxtechnology.com,https://www.sparkxtechnology.com

# Where new quote requests / inquiries are emailed
ADMIN_NOTIFY_EMAIL=directly888krock@gmail.com

# SMTP settings (e.g. Gmail app password, Resend, SendGrid, Zoho...)
# Leave SMTP_HOST empty to skip sending emails (requests are still saved).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SPARK X Technology <no-reply@sparkxtechnology.com>"

# ---- Accounts ----
# Long random string used to sign login tokens (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
# Frontend URL — used for links in verification / reset / quote emails
APP_URL=http://localhost:5173
# Accounts registered (or logging in) with these emails become admins
ADMIN_EMAILS=directly888krock@gmail.com
