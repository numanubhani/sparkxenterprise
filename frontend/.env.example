# URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:5000

# Public business email shown on the Contact page and footer
VITE_PUBLIC_EMAIL=info@sparkxtechnology.com

# Calendly (or similar) booking link for "Schedule a Call".
# Leave empty until it is connected to real availability — the page then offers "Request a Call" only.
VITE_CALENDLY_URL=

# Google Ads conversion tracking (fires after a successful quote request). Leave empty to disable.
VITE_GOOGLE_ADS_ID=            # e.g. AW-123456789
VITE_GOOGLE_ADS_CONVERSION_LABEL=
